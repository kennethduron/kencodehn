rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
        && validAdminRole(get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role);
    }

    function validAdminRole(role) {
      return role == 'owner'
        || role == 'admin'
        || role == 'manager'
        || role == 'viewer'
        || role == 'sales_agent';
    }

    function adminRole() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role;
    }

    function globalLeadScope() {
      return adminRole() == 'owner'
        || adminRole() == 'admin'
        || adminRole() == 'manager'
        || adminRole() == 'viewer';
    }

    function assignedLead(leadId) {
      return exists(/databases/$(database)/documents/leads/$(leadId))
        && get(/databases/$(database)/documents/leads/$(leadId)).data.assignedToUid == request.auth.uid;
    }

    function canReadNotes() {
      return adminRole() == 'owner' || adminRole() == 'admin' || adminRole() == 'sales_agent';
    }

    function globalTaskScope() {
      return adminRole() == 'owner' || adminRole() == 'admin';
    }

    function assignedTask() {
      return adminRole() == 'sales_agent'
        && resource.data.assignedToUid == request.auth.uid
        && (!('leadId' in resource.data) || resource.data.leadId == null || assignedLead(resource.data.leadId));
    }

    function canReadNotification() {
      return (('recipientUid' in resource.data) && resource.data.recipientUid == request.auth.uid)
        || ((adminRole() == 'owner' || adminRole() == 'admin')
          && (!('recipientUid' in resource.data) || resource.data.recipientUid == null));
    }

    function canReadActivity() {
      return adminRole() == 'owner' || adminRole() == 'admin' || adminRole() == 'sales_agent';
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /leads/{leadId} {
      allow read: if adminUser()
        && (globalLeadScope() || resource.data.assignedToUid == request.auth.uid);
      allow write: if false;
    }

    match /notes/{noteId} {
      allow read: if adminUser() && canReadNotes()
        && (globalLeadScope() || assignedLead(resource.data.leadId));
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read: if adminUser() && (globalTaskScope() || assignedTask());
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if adminUser() && canReadNotification();
      allow write: if false;
    }

    match /activityLogs/{logId} {
      allow read: if adminUser() && canReadActivity()
        && (globalLeadScope()
          || (('recipientUid' in resource.data) && resource.data.recipientUid == request.auth.uid)
          || (resource.data.leadId != null && assignedLead(resource.data.leadId)));
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
